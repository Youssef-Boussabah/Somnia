# Copy to .env (gitignored) and set a local-only password.
SOMNIA_DB_ADMIN_USER=somnia_admin
SOMNIA_DB_ADMIN_PASSWORD=change-me-local-only
SOMNIA_DB_PORT=5433
# Application connection (development database).
SOMNIA_DATABASE_URL=postgresql://somnia_admin:change-me-local-only@127.0.0.1:5433/somnia
# Content-addressed artifact store (gitignored).
SOMNIA_ARTIFACT_DIR=var/artifacts
