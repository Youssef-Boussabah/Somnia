{
  "$defs": {
    "SkillBody": {
      "additionalProperties": false,
      "description": "The immutable, hashed content of a skill version.",
      "properties": {
        "applicability": {
          "additionalProperties": true,
          "description": "e.g. {\"domain\": \"python-reliability\", \"requires_tags\": [...]}",
          "title": "Applicability",
          "type": "object"
        },
        "exclusions": {
          "additionalProperties": true,
          "description": "e.g. {\"tags\": [\"irreversible-external-effect\"]}",
          "title": "Exclusions",
          "type": "object"
        },
        "known_limits": {
          "title": "Known Limits",
          "type": "string"
        },
        "prerequisites": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "procedure": {
          "title": "Procedure",
          "type": "string"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "title",
        "procedure",
        "applicability",
        "exclusions",
        "known_limits"
      ],
      "title": "SkillBody",
      "type": "object"
    },
    "SkillSetMember": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "$ref": "#/$defs/SkillBody"
        },
        "content_hash": {
          "description": "sha256(canonical_json({body, parent_version_id}))",
          "title": "Content Hash",
          "type": "string"
        },
        "gate_decision_id": {
          "format": "uuid",
          "title": "Gate Decision Id",
          "type": "string"
        },
        "gate_independent": {
          "title": "Gate Independent",
          "type": "boolean"
        },
        "gate_is_mock": {
          "title": "Gate Is Mock",
          "type": "boolean"
        },
        "parent_version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Version Id"
        },
        "skill_id": {
          "format": "uuid",
          "title": "Skill Id",
          "type": "string"
        },
        "skill_slug": {
          "title": "Skill Slug",
          "type": "string"
        },
        "skill_version_id": {
          "format": "uuid",
          "title": "Skill Version Id",
          "type": "string"
        },
        "token_length": {
          "title": "Token Length",
          "type": "integer"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "skill_slug",
        "skill_id",
        "skill_version_id",
        "version",
        "parent_version_id",
        "content_hash",
        "gate_decision_id",
        "gate_is_mock",
        "gate_independent",
        "token_length",
        "body"
      ],
      "title": "SkillSetMember",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Frozen skill-set view an evaluator consumes (v2). Verify it with\n``somnia.export_verify.verify_skill_set_export(json, trusted_digest)``: the export digest is\nSHA-256 over the canonical JSON of the whole document and must come from a trusted channel,\nnever from the document itself. See contracts/README.md.",
  "properties": {
    "canonicalization": {
      "const": "somnia-cjson-v1",
      "default": "somnia-cjson-v1",
      "title": "Canonicalization",
      "type": "string"
    },
    "contains_mock_validation": {
      "description": "True iff any member's gate_is_mock is true",
      "title": "Contains Mock Validation",
      "type": "boolean"
    },
    "content_hash": {
      "description": "sha256(canonical_json({members: [{skill_id, skill_version_id, gate_decision_id}] sorted by skill_id}))",
      "title": "Content Hash",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/SkillSetMember"
      },
      "title": "Members",
      "type": "array"
    },
    "predecessor_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Predecessor Id"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "skill_set_id": {
      "format": "uuid",
      "title": "Skill Set Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "skill_set_id",
    "project_id",
    "version",
    "predecessor_id",
    "content_hash",
    "contains_mock_validation",
    "members"
  ],
  "title": "SkillSetExport",
  "type": "object"
}
